# Wildvogelreha Environment Configuration
# KOPIERE diese Datei zu .env und fülle die Werte aus!
# NIEMALS .env in Git committen!

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=wildvogelreha_user
DB_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
DB_ROOT_PASSWORD=GENERATE_SECURE_ROOT_PASSWORD_HERE
DB_NAME=wildvogelreha

# JWT Secret - MUSS mindestens 64 Zeichen sein!
# Generiere mit: openssl rand -base64 64
JWT_SECRET=GENERATE_64_CHAR_SECRET_HERE

# Environment
NODE_ENV=production
